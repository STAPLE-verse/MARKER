# Postgres connection string (shared with STAPLE — same DB, same User table).
DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# Auth.js session/token signing secret. Generate one with `npx auth secret`
# (writes to .env directly) or `openssl rand -base64 33`.
AUTH_SECRET=""

# Public base URL of this deployment, used to build absolute links (e.g. in
# emails, notifications). No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL of the STAPLE app, where sign-up and password reset happen (MARKER
# has no accounts of its own). No trailing slash. Defaults to production
# STAPLE when unset; point it at your local STAPLE for development.
NEXT_PUBLIC_STAPLE_URL="https://app.staplescience.com"

# Resend API key for outgoing email (invitations, password/profile change
# notices) — the same key STAPLE uses, so both send from staplescience.com.
# Leave empty to send no email at all (each skipped email is logged).
RESEND_API_KEY=""

# Optional sender override. Its domain must be verified in Resend.
# EMAIL_FROM="MARKER <app@staplescience.com>"
